# Commit lock files so CI/providers stay pinned (.terraform/ dirs stay ignored)

# Secrets / env
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
.cursor/
AGENTS.md

# Eval / trace artifacts (regenerable, keep out of git)
eval/results/**
!eval/results/.gitkeep
!eval/results/latest-summary.md
traces/
*.log

# Regenerable public corpus downloads (manifest is under search/)
corpus/waf/
corpus/asb/
corpus/nist/
corpus/terraform/

# Agent deploy metadata (local)
agents/.last-deploy.json

# Azure Functions local settings
tools/functions/**/local.settings.json
serving/evidence/*.log
